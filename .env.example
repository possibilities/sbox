# Values here are examples only. Bun reads .env automatically.
SBOX_HOST=127.0.0.1
SBOX_PORT=7070
# Required for non-loopback binds (at least 16 characters).
# SBOX_TOKEN=
# SBOX_DATA_DIR=/absolute/path/to/sbox-data
# SBOX_IMAGE=registry.example.com/your/sbox-runtime:tag
# SBOX_PUBLIC_URL=https://sbox.example.com
# SBOX_PREVIEW_HOST=previews.example.com
# Defaults also come from ~/.config/hypeman/cli.yaml.
HYPEMAN_BASE_URL=http://127.0.0.1:4973
# HYPEMAN_API_KEY=

# Optional companion beside Hypeman: atomic drive capture + configurable restores.
# SBOX_STORAGE_URL=http://127.0.0.1:7071
# SBOX_STORAGE_TOKEN=
