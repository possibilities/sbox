{
  "name": "@sbox/sandbox",
  "version": "0.1.0",
  "description": "A Bun and TypeScript sandbox platform powered by Hypeman microVMs",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./hypeman": "./src/hypeman/index.ts",
    "./host": "./src/host/index.ts",
    "./harnesses": "./src/harnesses/index.ts",
    "./proxy": "./src/sdk/proxy.ts"
  },
  "bin": {
    "sbox": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts serve",
    "start": "bun src/cli/index.ts serve",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build": "bun build ./src/cli/index.ts --compile --outfile dist/sbox",
    "test:live": "SBOX_LIVE_TEST=1 bun test tests/live.test.ts tests/*.live.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "fflate": "0.8.2",
    "re2-wasm": "^1.0.2",
    "reflect-metadata": "^0.2.2"
  }
}
